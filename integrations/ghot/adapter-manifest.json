{
  "schema": "ghot.external-adapter-manifest/v0",
  "adapter_id": "haunted-toaster.witness-sigil",
  "capabilities": [
    {
      "capability": "creative.toaster.witness-sigil",
      "protocol": "stdin-json/stdout-json-v0",
      "command": "node",
      "args": ["witness-sigil.cjs"],
      "timeout_seconds": 10,
      "limits": {
        "network": false,
        "arbitrary_shell": false,
        "writes_only_requested_output_dir": true
      }
    }
  ]
}
