{
  "name": "haunted-toaster",
  "productName": "The Haunted Toaster",
  "version": "0.5.0-alpha.4",
  "description": "A local-first desktop instrument that turns a finished song into a finished music video with a cryptographic receipt.",
  "author": "The Static Collective",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "src/main.cjs",
  "exports": {
    ".": "./src/main.cjs",
    "./generation": "./src/generation/index.cjs"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "smoke": "node scripts/smoke-render.cjs && node scripts/smoke-candidates.cjs",
    "prepare-build-info": "node scripts/prepare-build-info.cjs",
    "pack": "npm run prepare-build-info && electron-builder --dir",
    "dist": "npm run prepare-build-info && electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.staticcollective.hauntedtoaster",
    "productName": "The Haunted Toaster",
    "artifactName": "Haunted-Toaster-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "src/**/*",
      "constraints/**/*",
      "profiles/**/*",
      "docs/**/*",
      "package.json",
      "README.md",
      "DEMO.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
